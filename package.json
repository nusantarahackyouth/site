{
  "name": "site",
  "private": true,
  "scripts": {
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "dev": "bun run --cwd apps/frontend build && turbo run dev",
    "build": "turbo run build",
    "preview": "bun run --cwd apps/frontend build && bun run --cwd apps/frontend preview",
    "frontend:dev": "bun run --cwd apps/frontend dev",
    "frontend:build": "bun run --cwd apps/frontend build",
    "backend:dev": "bun run --cwd apps/backend dev",
    "backend:build": "bun run --cwd apps/backend build"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
