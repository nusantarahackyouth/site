---
import Layout from "@/layouts/Layout.astro";

import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import eventImages from "@/assets/_imports";
import { cn } from "cn";

const collection = await getCollection("events");
---

<Layout>
  <section class="relative overflow-y-clip bg-indigo-800/20 dark:bg-indigo-800/10">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -bottom-8 left-[50%] translate-x-[-50%] bg-indigo-500/40 dark:bg-indigo-500/20 h-96 rounded-t-full w-[80vw] blur-[6rem]" />
    </div>
    <div class="pt-36 pb-24 relative z-10 w-screen grid grid-cols-1 md:grid-cols-2 gap-4 inner items-center">
      <div class="flex flex-col font-serif text-[2.5rem] leading-tight sm:text-5xl lg:text-6xl tracking-tight font-medium">
        <div class="w-full -mt-8 text-center md:text-left lg:w-[unset] flex flex-wrap items-baseline gap-x-[0.2em]">
          <p>
            Hackathons isn't just about coding, it's about the{" "}
            <span class="px-3 bg-indigo-600 text-white -rotate-3">fun</span> and{" "}
            <span class="px-3 bg-indigo-600 text-white -rotate-3">
              creativity
            </span>
          </p>
        </div>
      </div>
      <div class="flex flex-col font-serif text-[2.5rem] leading-tight sm:text-5xl lg:text-6xl tracking-tight font-medium">
        <span class="w-full text-center md:text-left lg:w-[unset] relative ml-8 -mr-8">
          <Image
            src={eventImages["/events/sunbeam-jakarta-26/photo-01.jpg"]}
            width={960}
            format="webp"
            quality={90}
            alt=""
            class="w-[50%] border rounded-md border-white -rotate-2 drop-shadow-lg hover:-translate-x-4 hover:-translate-y-2 transition-transform duration-300 ease-[cubic-bezier(0.34,1.3,0.64,1)]"
          />
          <Image
            src={eventImages["/events/sunbeam-jakarta-26/photo-02.jpg"]}
            width={960}
            format="webp"
            quality={90}
            alt=""
            class="w-[50%] border rounded-md border-white translate-y-[-70%] translate-x-[50%] rotate-3 drop-shadow-lg hover:translate-x-[55%] hover:translate-y-[-75%] transition-transform duration-300 ease-[cubic-bezier(0.34,1.3,0.64,1)]"
          />
          <Image
            src={eventImages["/events/sunbeam-jakarta-26/photo-03.jpg"]}
            width={960}
            format="webp"
            quality={90}
            alt=""
            class="w-[50%] absolute border rounded-md border-white translate-y-[-120%] translate-x-[15%] rotate-1 drop-shadow-lg hover:translate-x-[13%] hover:translate-y-[-130%] transition-transform duration-300 ease-[cubic-bezier(0.34,1.3,0.64,1)]"
          />
        </span>
      </div>
    </div>
  </section>
  <section class="inner py-8 flex flex-col gap-6">
    <div class="z-10 flex flex-col gap-6 w-full">
      {collection
        .sort((a, b) => (a.data.orderIndex || 0) - (b.data.orderIndex || 0))
        .map((event, i) => (
          <div
            class={`relative w-full p-8 pb-16 md:pb-8 border rounded-xl flex gap-6 ${i % 2 === 0 ? "flex-col md:flex-row" : "flex-col md:flex-row-reverse"}`}
            style={{
              background:
                "linear-gradient(180deg, rgba(15, 23, 42, 0) 0%, rgba(15, 23, 42, 0.1) 30%, rgba(15, 23, 42, 0.3) 60%, rgba(15, 23, 42, 0.5) 100%)",
            }}
          >
            <span
              class={`flex flex-col gap-4 bg-white p-4 pb-10 text-black antialiased drop-shadow-2xl md:max-w-1/3 transition hover:scale-115 ${i % 2 === 0 ? "-rotate-1 hover:-rotate-3" : "rotate-1 hover:rotate-3"}`}
            >
              <Image
                src={
                  eventImages[
                    (event.data.thumbnail ||
                      event.data.image[0]) as keyof typeof eventImages
                  ]
                }
                alt={event.data.title}
                width={480}
                format="webp"
                quality={80}
                class="w-full aspect-video object-cover"
              />
            </span>
            <div class="flex flex-col gap-2 my-4">
              <span class="flex items-center gap-2">
                <Image
                  src={eventImages[event.data.logo as keyof typeof eventImages]}
                  alt={event.data.title}
                  width={480}
                  format="webp"
                  quality={80}
                  class="size-12 rounded-full"
                />
                <h2 class="text-3xl font-bold">{event.data.title}</h2>
              </span>
              <p class="text-sm w-11/12">{event.data.description}</p>
            </div>
            <div class="absolute inset-0 overflow-clip w-full h-full rounded-xl pointer-events-none">
              {event.data.accent && (
                <Image
                  src={
                    eventImages[event.data.accent as keyof typeof eventImages]
                  }
                  alt={event.data.title}
                  width={480}
                  format="webp"
                  quality={80}
                  class={cn(
                    `absolute max-md:w-72 max-md:bottom-[-25%] md:bottom-[1/2] ${i % 2 === 0 ? "right-[-10%]" : "left-[-10%]"}`,
                    event.data.classNames?.accent,
                  )}
                />
              )}
              <div
                class={`absolute bottom-2 size-18 bg-white blur-[8rem] ${i % 2 === 0 ? "right-8" : "left-8"}`}
              ></div>
            </div>
          </div>
        ))}
    </div>
  </section>
</Layout>
