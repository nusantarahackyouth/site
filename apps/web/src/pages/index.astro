---
import { rpc } from "@/lib/rpc";
import Layout from "@/layouts/Layout.astro";
import HeroShowcase from "@/components/features/landing/hero-showcase";
import HeroTitle from "@/components/features/landing/hero-title";
import { Button } from "@/components/ui/button";
import { getLang, t } from "@nhy/i18n";
import { getImage } from "astro:assets";

import Sunbeam01 from "@/assets/photography/sunbeam-jakarta-26/photo-01.jpg";
import Sunbeam02 from "@/assets/photography/sunbeam-jakarta-26/photo-02.jpg";
import Sunbeam03 from "@/assets/photography/sunbeam-jakarta-26/photo-03.jpg";

// Add assets to optimize, and pass to HeroShowcase
const showcaseSources = [
  { source: Sunbeam01, alt: "Sunbeam Jakarta gathering" },
  { source: Sunbeam02, alt: "Sunbeam Jakarta participants" },
  { source: Sunbeam03, alt: "Sunbeam Jakarta activities" },
];
const showcaseImages = await Promise.all(
  showcaseSources.map(async ({ source, alt }) => {
    const widths = [
      ...new Set(
        [640, 960, 1280].map((width) => Math.min(width, source.width)),
      ),
    ];
    const variants = await Promise.all(
      widths.map(async (width) => ({
        width,
        image: await getImage({
          src: source,
          width,
          format: "webp",
          quality: 90,
        }),
      })),
    );
    const largest = variants.at(-1)!;

    return {
      src: largest.image.src,
      srcSet: variants
        .map(({ image, width }) => `${image.src} ${width}w`)
        .join(", "),
      width: largest.width,
      height: Math.round((source.height / source.width) * largest.width),
      alt,
    };
  }),
);

const data = await rpc.v1.$get();
const result = await data.json();
const lang = getLang();
---

<Layout>
  <section class="relative min-h-screen pb-40">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <!-- <FaultyTerminal
        scale={0.4}
        digitSize={1.5}
        scanlineIntensity={0.3}
        glitchAmount={1.4}
        flickerAmount={0}
        noiseAmp={0.15}
        chromaticAberration={0.1}
        dither={0.3}
        curvature={0.2}
        tint="#dddddd"
        mouseReact
        mouseStrength={0.2}
        brightness={0.7}
        client:only="react"
      /> -->
      <div class="absolute bottom-0 left-[50%] translate-x-[-50%] bg-red-600/50 h-96 rounded-t-full w-[80vw] blur-[6rem]" />
    </div>
    <div class="relative z-20 flex flex-col items-center justify-center inner gap-6 py-48 pb-40">
      <HeroTitle client:load />
      <p
        class="text-lg sm:text-xl max-w-2xl text-center text-muted-foreground"
        data-i18n="hero.description"
      >
        {t("hero.description", lang)}
      </p>
      <div class="flex gap-2 items-center pointer-events-auto">
        <Button
          className="rounded-full p-5 text-lg shimmer-hover hover:bg-primary cursor-pointer"
          size="lg"
        >
          Something
        </Button>
        <Button
          className="rounded-full p-5 text-lg"
          size="lg"
          variant="outline"
        >
          Something
        </Button>
      </div>
    </div>
    <div class="relative z-20 px-8 flex flex-col items-center drop-shadow-2xl">
      <HeroShowcase images={showcaseImages} client:load />
    </div>
  </section>
</Layout>
