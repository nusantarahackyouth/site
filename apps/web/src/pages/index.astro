---
import { rpc } from "@/lib/rpc";
import Layout from "@/layouts/Layout.astro";
import FaultyTerminal from "@/components/FaultyTerminal";
import HeroShowcase from "@/components/features/landing/hero-showcase";
import HeroTitle from "@/components/features/landing/hero-title";
import { Button } from "@/components/ui/button";
import { getLang, t } from "@nhy/i18n";

const data = await rpc.v1.$get();
const result = await data.json();
const lang = getLang();
---

<Layout>
  <section class="relative min-h-screen pb-40">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <!-- <FaultyTerminal
        scale={0.4}
        digitSize={1.5}
        scanlineIntensity={0.3}
        glitchAmount={1.4}
        flickerAmount={0}
        noiseAmp={0.15}
        chromaticAberration={0.1}
        dither={0.3}
        curvature={0.2}
        tint="#dddddd"
        mouseReact
        mouseStrength={0.2}
        brightness={0.7}
        client:only="react"
      /> -->
      <div class="absolute bottom-0 left-[50%] translate-x-[-50%] bg-red-600/80 h-[24rem] rounded-t-full w-[80vw] blur-[6rem]" />
    </div>
    <div class="relative z-20 flex flex-col items-center justify-center inner gap-6 min-h-screen py-20 pb-[10%]">
      <HeroTitle client:load />
      <p
        class="text-lg sm:text-xl max-w-2xl text-center text-muted-foreground"
        data-i18n="hero.description"
      >
        {t("hero.description", lang)}
      </p>
      <div class="flex gap-2 items-center pointer-events-auto">
        <Button className="rounded-full p-5 text-lg" size="lg">
          Something
        </Button>
        <Button
          className="rounded-full p-5 text-lg"
          size="lg"
          variant="outline"
        >
          Something
        </Button>
      </div>
    </div>
    <div class="relative z-20 mt-[-25vh] flex flex-col items-center drop-shadow-2xl">
      <HeroShowcase client:load />
    </div>
  </section>
</Layout>
