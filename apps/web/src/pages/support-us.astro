---
import Layout from "@/layouts/Layout.astro";
import { getLang, t } from "@nhy/i18n";

const lang = getLang(Astro.request);
---

<Layout>
  <section class="w-full min-h-screen flex justify-center items-center flex-col gap-y-4">
    <div class="flex flex-col font-serif text-[2.5rem] leading-tight sm:text-5xl lg:text-6xl tracking-tight font-medium">
      <div class="w-full -mt-8 text-center md:text-left lg:w-[unset] flex flex-wrap items-baseline gap-x-[0.2em]">
        <p>
          Coming really{" "}
          <span class="px-3 bg-indigo-600 text-white -rotate-3">soon.</span>
        </p>
      </div>
    </div>
    <div class="flex flex-col text-center gap-1">
      <p class="text-lg">we're still working on this page.</p>
      <p class="text-lg">
        in the meantime, check out our{" "}
        <a href="/" class="text-indigo-500 dark:text-indigo-300">
          home page
        </a>
        .
      </p>
    </div>
  </section>
</Layout>
