---
import Layout from "@/layouts/Layout.astro";
import { getLang, t } from "@nhy/i18n";

const lang = getLang(Astro.request);
---

<Layout>
  <section class="w-full min-h-screen flex justify-center items-center flex-col gap-y-4">
    <h1 data-i18n="404.title">{t("404.title", lang)}</h1>
    <p data-i18n="404.description">{t("404.description", lang)}</p>
    <a href="/" data-i18n="404.return">
      {t("404.return", lang)}
    </a>
  </section>
</Layout>
