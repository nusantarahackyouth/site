---
import { rpc } from "@/lib/rpc";
import Layout from "@/layouts/Layout.astro";
import { getLang, t } from "@nhy/i18n";

import Sunbeam01 from "@/assets/photography/sunbeam-jakarta-26/photo-01.jpg";
import Sunbeam02 from "@/assets/photography/sunbeam-jakarta-26/photo-02.jpg";
import Sunbeam03 from "@/assets/photography/sunbeam-jakarta-26/photo-03.jpg";
import { Image } from "astro:assets";

const data = await rpc.v1.$get();
const lang = getLang();
---

<Layout>
  <section class="relative overflow-y-clip bg-indigo-800/20 dark:bg-indigo-800/10">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -bottom-8 left-[50%] translate-x-[-50%] bg-indigo-500/40 dark:bg-indigo-500/20 h-96 rounded-t-full w-[80vw] blur-[6rem]" />
    </div>
    <div class="pt-36 pb-24 relative z-10 w-screen grid grid-cols-1 md:grid-cols-2 gap-4 inner items-center">
      <div class="flex flex-col font-serif text-[2.5rem] leading-tight sm:text-5xl lg:text-6xl tracking-tight font-medium">
        <div class="w-full -mt-8 text-center md:text-left lg:w-[unset] flex flex-wrap items-baseline gap-x-[0.2em]">
          <p>
            Hackathons isn't just about coding, it's about the{" "}
            <span class="px-3 bg-indigo-600 text-white -rotate-3">fun</span> and{" "}
            <span class="px-3 bg-indigo-600 text-white -rotate-3">
              creativity
            </span>
          </p>
        </div>
      </div>
      <div class="flex flex-col font-serif text-[2.5rem] leading-tight sm:text-5xl lg:text-6xl tracking-tight font-medium">
        <span class="w-full text-center md:text-left lg:w-[unset] relative ml-8 -mr-8">
          <Image
            src={Sunbeam01}
            width={960}
            format="webp"
            quality={90}
            alt=""
            class="w-[50%] border rounded-md border-white -rotate-2 drop-shadow-lg hover:-translate-x-4 hover:-translate-y-2 transition-transform duration-300 ease-[cubic-bezier(0.34,1.3,0.64,1)]"
          />
          <Image
            src={Sunbeam02}
            width={960}
            format="webp"
            quality={90}
            alt=""
            class="w-[50%] border rounded-md border-white translate-y-[-70%] translate-x-[50%] rotate-3 drop-shadow-lg hover:translate-x-[55%] hover:translate-y-[-75%] transition-transform duration-300 ease-[cubic-bezier(0.34,1.3,0.64,1)]"
          />
          <Image
            src={Sunbeam03}
            width={960}
            format="webp"
            quality={90}
            alt=""
            class="w-[50%] absolute border rounded-md border-white translate-y-[-120%] translate-x-[15%] rotate-1 drop-shadow-lg hover:translate-x-[13%] hover:translate-y-[-130%] transition-transform duration-300 ease-[cubic-bezier(0.34,1.3,0.64,1)]"
          />
        </span>
      </div>
    </div>
  </section>
</Layout>
