---
import { rpc } from "@/lib/rpc";
import Layout from "@/layouts/Layout.astro";
import { getLang, t } from "@nhy/i18n";

import Sunbeam01 from "@/assets/photography/sunbeam-jakarta-26/photo-01.jpg";
import Sunbeam02 from "@/assets/photography/sunbeam-jakarta-26/photo-02.jpg";
import Sunbeam03 from "@/assets/photography/sunbeam-jakarta-26/photo-03.jpg";
import { Image } from "astro:assets";

const data = await rpc.v1.$get();
const lang = getLang();
---

<Layout>
  <section class="bg-indigo-800">
    <div class="pt-40 pb-20 w-screen grid grid-cols-1 md:grid-cols-2 gap-4 inner items-center">
      <div class="flex flex-col font-serif text-[2.5rem] leading-tight sm:text-5xl lg:text-6xl tracking-tight font-medium">
        <div class="w-full text-center md:text-left lg:w-[unset] flex flex-wrap items-baseline gap-x-[0.2em]">
          <p>
            Hackathons isn't just about coding, it's about the{" "}
            <span class="px-3 bg-foreground text-background -rotate-3">
              fun
            </span>{" "}
            and{" "}
            <span class="px-3 bg-foreground text-background -rotate-3">
              creativity
            </span>
          </p>
        </div>
      </div>
      <div class="flex flex-col font-serif text-[2.5rem] leading-tight sm:text-5xl lg:text-6xl tracking-tight font-medium">
        <span class="w-full text-center md:text-left lg:w-[unset] relative">
          <Image
            src={Sunbeam01}
            alt=""
            class="w-[50%] border rounded-md border-white -rotate-2"
          />
          <Image
            src={Sunbeam02}
            alt=""
            class="w-[50%] border rounded-md border-white translate-y-[-70%] translate-x-[50%] rotate-3"
          />
          <Image
            src={Sunbeam03}
            alt=""
            class="w-[50%] absolute border rounded-md border-white translate-y-[-120%] translate-x-[15%] rotate-1"
          />
        </span>
      </div>
    </div>
  </section>
</Layout>
