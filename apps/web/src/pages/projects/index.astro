---
import Layout from "@/layouts/Layout.astro";

import Sunbeam01 from "@/assets/events/sunbeam-jakarta-26/photo-01.jpg";
import Sunbeam02 from "@/assets/events/sunbeam-jakarta-26/photo-02.jpg";
import Sunbeam03 from "@/assets/events/sunbeam-jakarta-26/photo-03.jpg";
import { Image } from "astro:assets";
---

<Layout>
  <section class="relative overflow-y-clip bg-orange-800/20 dark:bg-orange-800/10">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -bottom-8 left-[50%] translate-x-[-50%] bg-orange-500/40 dark:bg-orange-500/20 h-96 rounded-t-full w-[80vw] blur-[6rem]" />
    </div>
    <div class="pt-36 pb-24 relative z-10 w-screen grid grid-cols-1 md:grid-cols-2 gap-4 inner items-center">
      <div class="flex flex-col font-serif text-[2.5rem] leading-tight sm:text-5xl lg:text-6xl tracking-tight font-medium">
        <div class="w-full -mt-8 text-center md:text-left lg:w-[unset] flex flex-wrap items-baseline gap-x-[0.2em]">
          <p>
            We make, We create, and do things{" "}
            <span class="px-3 bg-orange-600 text-white -rotate-3">
              in collaboration
            </span>
          </p>
        </div>
      </div>
      <div class="flex flex-col font-serif text-[2.5rem] leading-tight sm:text-5xl lg:text-6xl tracking-tight font-medium">
        <span class="w-full text-center md:text-left lg:w-[unset] relative">
          <Image
            src={Sunbeam01}
            width={960}
            format="webp"
            quality={90}
            alt=""
            class="w-[50%] border rounded-md border-white translate-y-[-10%] translate-x-[-10%] -rotate-2"
          />
          <Image
            src={Sunbeam02}
            width={960}
            format="webp"
            quality={90}
            alt=""
            class="w-[50%] border rounded-md border-white translate-y-[-120%] translate-x-[90%] rotate-3"
          />
          <Image
            src={Sunbeam03}
            width={960}
            format="webp"
            quality={90}
            alt=""
            class="w-[75%] absolute border rounded-md border-white translate-y-[-100%] translate-x-[10%] rotate-1"
          />
        </span>
      </div>
    </div>
  </section>
  <section class="w-full flex justify-center items-center flex-col mt-32">
    <div class="flex flex-col font-serif text-[2.5rem] leading-tight sm:text-5xl lg:text-6xl tracking-tight font-medium">
      <div class="w-full -mt-8 text-center md:text-left lg:w-[unset] flex flex-wrap items-baseline gap-x-[0.2em]">
        <p>
          Coming really{" "}
          <span class="px-3 bg-orange-600 text-white -rotate-3">soon.</span>
        </p>
      </div>
    </div>
    <div class="flex flex-col text-center gap-1">
      <p class="text-lg">we're still working on this page.</p>
      <p class="text-lg">
        in the meantime, check out our{" "}
        <a href="/" class="text-indigo-500 dark:text-indigo-300">
          home page
        </a>
        .
      </p>
    </div>
  </section>
</Layout>
