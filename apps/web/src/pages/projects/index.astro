---
import ServerAPI from "@/lib/requests/server";

import Layout from "@/layouts/Layout.astro";
import { getLang, t } from "@nhy/i18n";

import Sunbeam01 from "@/assets/events/sunbeam-jakarta-26/photo-01.jpg";
import Sunbeam02 from "@/assets/events/sunbeam-jakarta-26/photo-02.jpg";
import Sunbeam03 from "@/assets/events/sunbeam-jakarta-26/photo-03.jpg";
import { Image } from "astro:assets";

const result = await ServerAPI.getV1Test();
const lang = getLang(Astro.request);
---

<Layout>
  <section class="bg-amber-600">
    <div class="pt-40 pb-20 w-screen grid grid-cols-1 md:grid-cols-2 gap-4 inner items-center">
      <div class="flex flex-col font-serif text-[2.5rem] leading-tight sm:text-5xl lg:text-6xl tracking-tight font-medium">
        <div class="w-full text-center md:text-left lg:w-[unset] flex flex-wrap items-baseline gap-x-[0.2em]">
          <p>
            We make, We create, and do things{" "}
            <span class="px-3 bg-foreground text-background -rotate-3">
              in collaboration
            </span>
          </p>
        </div>
      </div>
      <div class="flex flex-col font-serif text-[2.5rem] leading-tight sm:text-5xl lg:text-6xl tracking-tight font-medium">
        <span class="w-full text-center md:text-left lg:w-[unset] relative">
          <Image
            src={Sunbeam01}
            width={960}
            format="webp"
            quality={90}
            alt=""
            class="w-[50%] border rounded-md border-white translate-y-[-10%] translate-x-[-10%] -rotate-2"
          />
          <Image
            src={Sunbeam02}
            width={960}
            format="webp"
            quality={90}
            alt=""
            class="w-[50%] border rounded-md border-white translate-y-[-120%] translate-x-[90%] rotate-3"
          />
          <Image
            src={Sunbeam03}
            width={960}
            format="webp"
            quality={90}
            alt=""
            class="w-[75%] absolute border rounded-md border-white translate-y-[-100%] translate-x-[10%] rotate-1"
          />
        </span>
      </div>
    </div>
  </section>
</Layout>
