---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

import Navbar from "@/components/core/Navbar.astro";
import { getLang } from "@nhy/i18n";

const lang = getLang();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="theme-color" content="#15111f" />

    <title>Nusantara Hack Youth</title>

    <script>
      (() => {
        function applyTheme() {
          const a = localStorage.getItem("@nhy/theme"),
            b =
              "light" === a || "dark" === a
                ? a
                : matchMedia("(prefers-color-scheme: dark)").matches
                  ? "dark"
                  : "light";
          document.documentElement.classList.toggle("dark", "dark" === b);
        }
        applyTheme();
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <Navbar />
    <slot />
    <script>
      import { swapTranslations, subscribeLocale, getLang } from "@nhy/i18n";

      function applyTheme() {
        const a = localStorage.getItem("@nhy/theme"),
          b =
            "light" === a || "dark" === a
              ? a
              : matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
        document.documentElement.classList.toggle("dark", "dark" === b);
      }

      function updateFlags() {
        const lang = getLang();
        const flagEN = document.getElementById("flag-en");
        const flagID = document.getElementById("flag-id");
        if (!flagEN || !flagID) return;
        if (lang === "id") {
          flagID.style.display = "block";
          flagEN.style.display = "none";
        } else {
          flagEN.style.display = "block";
          flagID.style.display = "none";
        }
      }

      swapTranslations();
      applyTheme();
      updateFlags();
      document.documentElement.classList.add("i18n-ready");

      document.addEventListener("astro:after-swap", () => {
        swapTranslations();
        applyTheme();
        updateFlags();
        document.documentElement.classList.add("i18n-ready");
      });

      subscribeLocale(() => {
        swapTranslations();
        applyTheme();
        updateFlags();
      });
    </script>
  </body>
</html>

<style is:global>
  html:not(.i18n-ready) [data-i18n] {
    visibility: hidden;
  }

  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
