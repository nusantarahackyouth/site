---
import Logo from "@/assets/logo.svg";
import FlagEN from "@/assets/flags/en.svg";
import FlagID from "@/assets/flags/id.svg";
import { getLang, t } from "@nhy/i18n";

const lang = getLang(Astro.request);
---

<script>
  import { getLang, setLang } from "@nhy/i18n";

  let navbarController: AbortController | undefined;

  function setupNavbar() {
    navbarController?.abort();
    navbarController = new AbortController();
    const { signal } = navbarController;

    const nav = document.querySelector<HTMLElement>("#navbar");
    const navbarLogo =
      document.querySelector<HTMLAnchorElement>("#navbar-logo");
    const navbarLogoVideo =
      navbarLogo?.querySelector<HTMLVideoElement>("video");
    const flagEN = document.querySelector<HTMLElement>("#flag-en");
    const flagID = document.querySelector<HTMLElement>("#flag-id");
    const transitionOverlay =
      document.querySelector<HTMLElement>("#i18n-transition");

    if (
      !nav ||
      !navbarLogo ||
      !navbarLogoVideo ||
      !flagEN ||
      !flagID ||
      !transitionOverlay
    ) {
      return;
    }

    const updateNav = () => {
      if (window.scrollY > 15) {
        nav.style.border = "1px solid var(--color-border)";
        nav.style.paddingInline = "2rem";
        nav.style.borderRadius = "9999px";
        nav.style.background =
          "color-mix(in oklab, var(--background) 20%, transparent)";
        nav.style.backdropFilter = "blur(4px)";
      } else {
        nav.style.border = "1px solid transparent";
        nav.style.paddingInline = "1rem";
        nav.style.borderRadius = "0";
        nav.style.background = "";
        nav.style.backdropFilter = "none";
      }
    };

    updateNav();
    window.addEventListener("scroll", updateNav, { passive: true, signal });

    let isLogoPlaying = false;
    navbarLogo.addEventListener(
      "mouseenter",
      () => {
        if (isLogoPlaying) return;

        isLogoPlaying = true;
        navbarLogoVideo.currentTime = 0;
        void navbarLogoVideo.play().catch(() => {
          isLogoPlaying = false;
        });
      },
      { signal },
    );

    navbarLogoVideo.addEventListener(
      "ended",
      () => {
        isLogoPlaying = false;
      },
      { signal },
    );

    const updateFlags = () => {
      if (getLang() === "id") {
        flagID.style.display = "block";
        flagEN.style.display = "none";
      } else {
        flagEN.style.display = "block";
        flagID.style.display = "none";
      }
    };

    const switchLang = async (lang: "en" | "id") => {
      transitionOverlay.style.opacity = "1";
      transitionOverlay.style.pointerEvents = "auto";

      await new Promise((resolve) => setTimeout(resolve, 300));
      if (signal.aborted) return;

      setLang(lang);
      updateFlags();

      await new Promise((resolve) => setTimeout(resolve, 700));
      if (signal.aborted) return;

      transitionOverlay.style.opacity = "0";
      transitionOverlay.style.pointerEvents = "none";
    };

    updateFlags();
    flagEN.addEventListener("click", () => void switchLang("id"), { signal });
    flagID.addEventListener("click", () => void switchLang("en"), { signal });
    window.addEventListener("locale-change", updateFlags, { signal });
  }

  setupNavbar();
</script>

<div
  id="i18n-transition"
  class="fixed inset-0 bg-white z-[9999] transition-opacity duration-500"
  style="opacity: 0; pointer-events: none;"
></div>
<nav
  id="navbar"
  class="fixed top-2 left-0 right-0 z-50 inner border border-transparent h-16 px-4 flex justify-between items-center transition-all duration-300"
>
  <a href="/" class="contents" id="navbar-logo">
    <div class="flex gap-3 items-center">
      <video
        muted
        playsinline
        disablepictureinpicture
        preload="auto"
        src="/logo.webm"
        class="size-8 invert dark:invert-0 pointer-events-none select-none"
        oncontextmenu="return false;"
      />
      <span class="font-jakarta-sans leading-4 font-semibold select-none">
        <p class="text-primary dark:text-[#f04051]">Nusantara</p>
        <p class="font-bold">Hack Youth</p>
      </span>
    </div>
  </a>
  <div class="flex gap-4 items-center text-sm font-semibold">
    <div class="hidden md:flex gap-2">
      <a href="/about" data-i18n="nav.about">
        {t("nav.about", lang)}
      </a>
      <span class="text-muted-foreground/50 select-none">/</span>
      <a href="/events" data-i18n="nav.events">
        {t("nav.events", lang)}
      </a>
      <span class="text-muted-foreground/50 select-none">/</span>
      <a href="/projects" data-i18n="nav.projects">
        {t("nav.projects", lang)}
      </a>
      <span class="text-muted-foreground/50 select-none">/</span>
      <a href="/support-us" data-i18n="nav.support">
        {t("nav.support", lang)}
      </a>
    </div>
    <div class="flex gap-1">
      <button
        id="flag-en"
        class="cursor-pointer"
        aria-label="Switch to English"
      >
        <FlagEN class="size-6" />
      </button>
      <button
        id="flag-id"
        class="cursor-pointer"
        aria-label="Switch to Indonesian"
      >
        <FlagID class="size-6" />
      </button>
    </div>
  </div>
</nav>
