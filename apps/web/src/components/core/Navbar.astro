---
import Logo from "@/assets/logo.svg";
import FlagEN from "@/assets/flags/en.svg";
import FlagID from "@/assets/flags/id.svg";
import { getLang, t } from "@nhy/i18n";

const lang = getLang();
---

<script>
  import { getLang, setLang } from "@nhy/i18n";

  const nav = document.querySelector("nav")!;
  function updateNav() {
    if (window.scrollY > 15) {
      nav.style.border = "1px solid var(--color-border)";
      nav.style.paddingInline = "2rem";
      nav.style.borderRadius = "9999px";
      nav.style.background =
        "color-mix(in oklab, var(--background) 20%, transparent)";
      nav.style.backdropFilter = "blur(4px)";
    } else {
      nav.style.border = "1px solid transparent";
      nav.style.paddingInline = "1rem";
      nav.style.borderRadius = "0";
      nav.style.background = "";
      nav.style.backdropFilter = "none";
    }
  }
  updateNav();
  window.addEventListener("scroll", updateNav);

  // Language switcher: show the flag of the CURRENT language
  const flagEN = document.getElementById("flag-en")!;
  const flagID = document.getElementById("flag-id")!;
  const transitionOverlay = document.getElementById("i18n-transition")!;

  function updateFlags() {
    const lang = getLang();
    if (lang === "id") {
      flagID.style.display = "block";
      flagEN.style.display = "none";
    } else {
      flagEN.style.display = "block";
      flagID.style.display = "none";
    }
  }

  updateFlags();

  async function switchLang(lang: "en" | "id") {
    transitionOverlay.style.opacity = "1";
    transitionOverlay.style.pointerEvents = "auto";

    await new Promise((r) => setTimeout(r, 300));

    setLang(lang);
    updateFlags();

    await new Promise((r) => setTimeout(r, 700));
    transitionOverlay.style.opacity = "0";
    transitionOverlay.style.pointerEvents = "none";
  }

  flagEN.addEventListener("click", () => switchLang("id"));
  flagID.addEventListener("click", () => switchLang("en"));

  // Re-sync flags when language changes (e.g. from another tab)
  window.addEventListener("locale-change", updateFlags);
</script>

<div
  id="i18n-transition"
  class="fixed inset-0 bg-white z-[9999] transition-opacity duration-500"
  style="opacity: 0; pointer-events: none;"
></div>
<div class="absolute top-0 h-32 pointer-events-none w-screen bg-linear-to-b from-background to-transparent z-50"></div>
<nav class="fixed top-2 left-0 right-0 z-50 inner h-16 px-4 flex justify-between items-center transition-all duration-300">
  <div class="flex gap-3 items-center">
    <Logo class="size-8 invert dark:invert-0" />
    <span class="font-jakarta-sans leading-4 font-semibold">
      <p class="text-primary">Nusantara</p>
      <p class="font-bold">Hack Youth</p>
    </span>
  </div>
  <div class="flex gap-4 items-center text-sm font-semibold">
    <div class="hidden md:flex gap-2">
      <a href="/" data-i18n="nav.about">
        {t("nav.about", lang)}
      </a>
      <span class="text-muted-foreground/50">/</span>
      <a href="/" data-i18n="nav.events">
        {t("nav.events", lang)}
      </a>
      <span class="text-muted-foreground/50">/</span>
      <a href="/" data-i18n="nav.projects">
        {t("nav.projects", lang)}
      </a>
      <span class="text-muted-foreground/50">/</span>
      <a href="/" data-i18n="nav.support">
        {t("nav.support", lang)}
      </a>
    </div>
    <div class="flex gap-1">
      <button
        id="flag-en"
        class="cursor-pointer"
        aria-label="Switch to English"
      >
        <FlagEN class="size-6" />
      </button>
      <button
        id="flag-id"
        class="cursor-pointer"
        aria-label="Switch to Indonesian"
      >
        <FlagID class="size-6" />
      </button>
    </div>
  </div>
</nav>
