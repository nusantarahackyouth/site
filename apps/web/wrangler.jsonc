{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nhy-site-fe",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "keep_vars": true,
  "routes": [
    {
      "pattern": "hackyouth.id",
      "zone_name": "hackyouth.id",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false,
    },
  ],
}
